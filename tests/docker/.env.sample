# Copy this file to .env (gitignored) and fill in your credentials.
# Used by run-real-camera-smoke.sh — never committed.

# Wyze account credentials
WYZE_USERNAME=
WYZE_PASSWORD=

# API key + ID from https://developer-api-console.wyze.com/
WYZE_KEY_ID=
WYZE_API_KEY=

# Optional — nickname of the camera to test against.
# If blank, the smoke uses the first online camera on the account.
WYZE_CAMERA_NICK=
